{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Was ["vite.config.ts"] alone, so playwright.config.ts, eslint.config.js,
     stryker.config.mjs and scripts/** belonged to no project and were
     type-checked by nothing (F71). checkJs stays off: these are plain JS with
     no annotations, so this buys syntax and module resolution, not inference. */
  "include": [
    "vite.config.ts",
    /* Imported by vite.config.ts, so it belongs to this project too — the app
       project also owns it, which is what lets the unit suite read it. */
    "src/pwa-manifest.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "stryker.config.mjs",
    "scripts/**/*.js",
    "scripts/**/*.mjs"
  ]
}
