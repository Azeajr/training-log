{
  "name": "training-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "check": "pnpm build && pnpm test",
    "check:local": "eslint . --cache --cache-location node_modules/.cache/eslint && tsc -b",
    "check:ci": "pnpm lint && pnpm test:coverage && pnpm build",
    "test:e2e": "playwright test",
    "verify:sw": "pnpm build && node scripts/verify-notify-hardening.js",
    "debug:browser": "node scripts/debug-browser.js",
    "debug:browser:nowipe": "node scripts/debug-browser.js --no-wipe"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tailwindcss/vite": "^4.3.3",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.5",
    "wrangler": "^4.136.3"
  },
  "packageManager": "pnpm@12.3.4"
}
