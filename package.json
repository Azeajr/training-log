{
  "name": "training-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "web-harness serve --dir dist --port 5175",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "web-harness mutate",
    "check": "pnpm build && pnpm test",
    "check:local": "eslint . --cache --cache-location node_modules/.cache/eslint && tsc -b",
    "check:ci": "pnpm lint && pnpm test:coverage && pnpm build",
    "test:e2e": "playwright test",
    "verify:sw": "pnpm build && node scripts/verify-notify-hardening.js",
    "harness": "web-harness",
    "smoke": "web-harness smoke",
    "test:e2e:container": "web-harness e2e"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.1",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tailwindcss/vite": "^4.3.4",
    "solid-js": "^1.9.18",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@azeajr/web-harness": "github:Azeajr/web-harness#v0.2.7",
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^4.1.5",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@12.3.4"
}
