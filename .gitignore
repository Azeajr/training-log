# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
scripts/screenshot.png

# Local tooling
# Ignore local Claude scratch while keeping the tracked guides and any new docs visible.
.claude/settings.local.json
.claude/agents/
.claude/completions/*
.claude/sessions/*
.playwright-mcp/
.agents/
skills-lock.json
training-log-*.json

# Test coverage output (regenerable via `npm run test:coverage`)
coverage/
reports/
stryker-setup-*.js

# Playwright run artifacts — per-failure screenshots, videos and traces, plus a
# .last-run.json receipt. `.last-run.json` used to be TRACKED, and its committed
# copy read {"status":"passed"} in a repo where the suite did not pass and
# nothing ran it: a stale green receipt anyone could read and believe.
test-results/
playwright-report/

# Hermes agent worktrees — worker checkouts, never committed
.worktrees/

# Python bytecode. A .pyc for scripts/migrate-history.py was tracked for
# months — machine-specific, regenerated on every run.
__pycache__/
*.pyc
